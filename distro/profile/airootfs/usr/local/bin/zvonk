#!/usr/bin/env bash
# zvonk — генератор звонков ZвонкиОС
# звонки не отменяются

set -uo pipefail

GREEN=$'\033[1;32m'
DGREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[1;31m'
DIM=$'\033[2m'
NC=$'\033[0m'

memes=(
  "поставил ZвонкиОС — звонки стали приходить даже во сне"
  "pacman -Syu сказал 'всё ок', но я ему не верю"
  "минимализм: удалил всё лишнее. остался только звонок"
  "олегаподобность — это когда дистро работает, но непонятно как"
  "я не страдаю в терминале, я там живу"
  "блинчик лох кстати"
  "установил арч — теперь рассказываю всем, что установил арч"
  "звонки не отменяются. как и зависимости в AUR"
  "мой конфиг — это 400 строк комментариев и одна рабочая строчка"
  "вайпнул систему, стало легче. не мне, системе"
  "ZвонкиОС: 3 гигабайта чистого рофла и ни одного драйвера"
  "сборка прошла успешно. это подозрительно"
  "настоящий Звонковый не переустанавливает систему, он её уговаривает"
  "fsck /dev/zvonok: ошибок не найдено, но звонок всё равно идёт"
  "я и мой /etc/fstab: история недопонимания"
)

phone() {
  cat <<'EOF'
   .---------.
  /  ZVON     \
 |  .---.     |    ZVON ZVON
 |  |   |     |       ZVON
 |  `---'     |    ZVON ZVON
  \          /
   `---------'
EOF
}

random_meme() {
  printf '%s> %s%s\n' "$DGREEN" "${memes[RANDOM % ${#memes[@]}]}" "$NC"
}

usage() {
  cat <<EOF
${GREEN}zvonk${NC} — генератор звонков ZвонкиОС

  ${YELLOW}zvonk${NC}            случайный звонок с мемом
  ${YELLOW}zvonk --meme${NC}     только мем, без телефона
  ${YELLOW}zvonk --ring${NC}     позвонить (бесконечно, Ctrl+C — сбросить)
  ${YELLOW}zvonk --accept${NC}   принять звонок
  ${YELLOW}zvonk --decline${NC}  попробовать отклонить
  ${YELLOW}zvonk --help${NC}     эта справка

${DIM}звонки не отменяются${NC}
EOF
}

ring() {
  trap 'printf "\n%sзвонок сброшен. но это ненадолго.%s\n" "$DIM" "$NC"; exit 0' INT
  phone
  printf '\n'
  while true; do
    printf '\a%s  ZVON ZVON%s\n' "$GREEN" "$NC"
    sleep 2
  done
}

case "${1:-}" in
  "" )
    echo
    phone
    echo
    random_meme
    printf '\n%sещё: %szvonk --meme%s   позвонить: %szvonk --ring%s\n' \
      "$DIM" "$YELLOW" "$DIM" "$YELLOW" "$NC"
    ;;
  --meme|-m)
    random_meme
    ;;
  --ring|-r)
    ring
    ;;
  --accept|-a)
    printf '\n%s  ZVON ZVON%s\n\n' "$GREEN" "$NC"
    printf '%sты принял звонок. настоящий Звонковый.%s\n' "$GREEN" "$NC"
    printf '%s+1 к карме, -1 к продуктивности%s\n' "$DIM" "$NC"
    ;;
  --decline|-d)
    printf '\n%sотклонить нельзя.%s\n' "$RED" "$NC"
    printf '%sзвонки не отменяются.%s\n' "$GREEN" "$NC"
    ;;
  --help|-h)
    usage
    ;;
  *)
    printf '%sнеизвестный аргумент: %s%s\n\n' "$RED" "$1" "$NC" >&2
    usage
    exit 2
    ;;
esac
